APP_NAME=bot-lertisento
APP_ENV=development
APP_DEBUG=true
APP_AUTO_CREATE_TABLES=false
FEATURE_TOGGLES={"DELETE_USERS":true}
AUTH_REQUIRE_EMAIL_VERIFIED=false
APP_PUBLIC_BASE_URL=http://localhost:8000
AUTH_SESSION_COOKIE_NAME=auth_session
AUTH_SESSION_COOKIE_SECURE=false
AUTH_SESSION_ROTATE_BEFORE_HOURS=24
AUTH_RESEND_VERIFICATION_COOLDOWN_SECONDS=300
AUTH_FORGOT_PASSWORD_COOLDOWN_SECONDS=300
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_ATTEMPT_WINDOW_SECONDS=300
AUTH_LOGIN_LOCKOUT_SECONDS=900
AUTH_CSRF_COOKIE_NAME=csrf_token
AUTH_CSRF_COOKIE_SECURE=false

POSTGRES_DB=bot_lertisento
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/bot_lertisento

REDIS_URL=redis://redis:6379/0

ZONE_SMTP_HOST=smtp.zone.eu
ZONE_SMTP_PORT=587
ZONE_IMAP_HOST=imap.zone.eu
ZONE_IMAP_PORT=993
ZONE_EMAIL=sales@example.com
ZONE_PASSWORD=change-me
ZONE_USE_STARTTLS=true
MAIL_DAILY_LIMIT=100
MAIL_MIN_INTERVAL_SECONDS=30

OPENAI_API_KEY=
OPENAI_MAIN_MODEL=gpt-5.4
OPENAI_MINI_MODEL=gpt-5.4-mini
